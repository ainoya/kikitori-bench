# xAI API key for Grok Speech-to-Text (STT) adapter
XAI_API_KEY=your_xai_api_key_here

# Gemini API key for Ground Truth drafting (Gemini 3.8 Flash) and Gemini ASR
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key for Groq-hosted Whisper (whisper-large-v3) adapter
GROQ_API_KEY=your_groq_api_key_here

# Meta API key for Muse Voice Transcribe adapter (requires ffmpeg for WAV conversion)
META_API_KEY=your_meta_api_key_here

# OpenAI API key for Whisper ASR adapter
OPENAI_API_KEY=your_openai_api_key_here

# Codex App Server configuration for LLM-as-a-judge (GPT-5.6 Luna)
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MODEL=gpt-5.6-luna

# Optional: stdio command for Codex App Server if not running WebSocket server
# CODEX_APP_SERVER_STDIO_CMD=codex app-server

# Obsidian vault directory holding the voice-journal notes to import
# (used by 'kikitori dataset import-journal'; personal path, never committed)
JOURNAL_VAULT_DIR=/path/to/your/vault/journal/2026

# Local Web UI review server port
REVIEW_PORT=3000
