{
  "name": "kikitori-bench",
  "version": "0.1.0",
  "description": "Private speech recognition benchmark with LLM-as-a-judge evaluation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kikitori": "dist/index.js",
    "kikitori-dev": "src/index.ts"
  },
  "scripts": {
    "build": "tsc && cp -r src/review/static dist/review/static",
    "apple:build": "swift build -c release --package-path tools/apple-speech-transcriber",
    "apple:prepare": "pnpm apple:build && tools/apple-speech-transcriber/.build/release/apple-speech-transcriber --prepare --engine speech-transcriber --locale ja-JP",
    "apple:prepare:dictation": "pnpm apple:build && tools/apple-speech-transcriber/.build/release/apple-speech-transcriber --prepare --engine dictation --locale ja-JP",
    "mlx:prepare": "uv venv tools/mlx-audio/.venv --python 3.12 && uv pip install --python tools/mlx-audio/.venv/bin/python mlx-audio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev": "tsx src/index.ts",
    "kikitori": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check:leaks": "tsx scripts/check-private-leaks.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepare": "effect-tsgo patch --typescript --oxlint && lefthook install"
  },
  "engines": {
    "node": "26"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.1",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.16.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.43.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "asr",
    "speech-recognition",
    "benchmark",
    "llm-judge",
    "effect",
    "gemini",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ainoya/kikitori-bench.git"
  }
}
