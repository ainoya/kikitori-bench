{
  "name": "kikitori-bench",
  "version": "0.1.0",
  "description": "Private speech recognition benchmark with LLM-as-a-judge evaluation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kikitori": "dist/index.js",
    "kikitori-dev": "src/index.ts"
  },
  "scripts": {
    "build": "tsc && cp -r src/review/static dist/review/static",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev": "tsx src/index.ts",
    "kikitori": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check:leaks": "tsx scripts/check-private-leaks.ts"
  },
  "engines": {
    "node": "26"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.1",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.15.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "asr",
    "speech-recognition",
    "benchmark",
    "llm-judge",
    "effect",
    "gemini",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ainoya/kikitori-bench.git"
  }
}
